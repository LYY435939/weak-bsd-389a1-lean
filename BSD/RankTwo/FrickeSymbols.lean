import BSD.RankTwo.ModularSymbols
import Mathlib.Tactic

/-!
# Fricke action on the level-389 Hecke eigensymbols

We use the bottom-row and orientation conventions of `ModularSymbols`. A
finite label `i` represents the path from 0 to 1/i, and the infinity label
represents the reverse of the central path. The matrix [0,−1;389,0] sends
the former to the path from infinity to −i/389. Continued fractions give
a chain of unimodular edges representing that path.

The integer certificate below uses two free periods, at indices 384 and
386. Its sparse pivot rows are integer combinations of the Manin and Hecke
relations; Lean checks every pivot and the images of both coordinate vectors.
-/

namespace BSD.RankTwo.ModularSymbols.Fricke

abbrev CuspPair := ℤ × ℤ

private def convergents : ℕ → ℤ → ℤ → CuspPair → CuspPair → List CuspPair
  | 0, _, _, _, _ => []
  | fuel + 1, a, b, prev, curr =>
    if b = 0 then [] else
      let q := a / b
      let next := (q * curr.1 + prev.1, q * curr.2 + prev.2)
      next :: convergents fuel b (a % b) curr next

/-- Rational cusps traversed after left multiplication by [0,−1;389,0]. -/
def frickeCusps (i : Index) : List CuspPair :=
  if i = 389 then [(0,1),(1,0)]
  else (1,0) :: convergents 24 (-(i.val : ℤ)) 389 (0,1) (1,0)

private def det (a b : CuspPair) := b.1 * a.2 - a.1 * b.2

/-- For an edge `a → b`, use columns `b, det(a,b) • a` so their determinant is one. -/
def frickePath (i : Index) : List Index :=
  let path := frickeCusps i
  path.zipWith (fun a b => project b.2 (det a b * a.2)) path.tail

private def endpointsValid (i : Index) : Bool :=
  let path := frickeCusps i
  let first : CuspPair := if i = 389 then (0,1) else (1,0)
  let last : CuspPair := if i = 389 then (1,0) else if i = 0 then (0,1) else (-(i.val : ℤ),389)
  decide (path.head? = some first ∧ path.getLast? = some last) &&
    (path.zipWith det path.tail).all fun z => decide (z = 1 ∨ z = -1)

set_option maxRecDepth 6000 in
set_option maxHeartbeats 0 in
private theorem checkEndpoints : (List.finRange 390).all endpointsValid = true := by decide +kernel

/-- Each chain has the stated Fricke endpoints, with every edge unimodular. -/
theorem frickeCusps_spec (i : Index) :
    (frickeCusps i).head? = some (if i = 389 then (0,1) else (1,0)) ∧
    (frickeCusps i).getLast? =
      some (if i = 389 then (1,0) else if i = 0 then (0,1) else (-(i.val : ℤ),389)) ∧
    ∀ z ∈ (frickeCusps i).zipWith det (frickeCusps i).tail, z = 1 ∨ z = -1 := by
  have h := List.all_eq_true.mp checkEndpoints i (List.mem_finRange i)
  simpa [endpointsValid, and_assoc] using h

/-- Relation labels 0–389 use S, 390–779 use R, and 780–1169 use T₂+2. -/
private def relation (n : ℕ) : List Index :=
  let i : Index := Fin.ofNat 390 n
  if n < 390 then [i, swap i] else if n < 780 then [i, rotate i, rotate (rotate i)]
  else heckeTwo i ++ [i,i]

