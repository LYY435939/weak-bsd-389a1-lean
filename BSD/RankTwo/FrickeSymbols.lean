private def position (i : Index) := pivotPositions[i.val]!
private def coord (i : Index) := coordinates[i.val]!
private def combination (i : Index) := pivotCombinations[i.val]!

private def expand (cs : Combination) : List (Index × ℤ) :=
  cs.flatMap fun (n,c) => (relation n).map (fun i => (i,c))

private def tally (xs : List (Index × ℤ)) (v : Vector ℤ 390) : Vector ℤ 390 :=
  xs.foldl (fun acc (i,c) => acc.set i.val (acc[i.val] + c)) v

private def weights (i : Index) : Vector ℤ 390 :=
  tally (expand (combination i)) (Vector.replicate 390 0)

private def weightAt (xs : List (Index × ℤ)) (j : Index) : ℤ :=
  (xs.map fun (i,c) => if i = j then c else 0).sum

private def forbidden (i : Index) (t : Index × ℤ) : Bool :=
  decide (t.1 ≠ i ∧ position i ≤ position t.1)

private def pivotValid (i : Index) : Bool :=
  if i = 384 ∨ i = 386 then true else
  let xs := expand (combination i)
  decide (weightAt xs i ≠ 0) &&
    decide (tally (xs.filter (forbidden i)) (Vector.replicate 390 0) = Vector.replicate 390 0)

private def coordSum (l : List Index) : ℤ × ℤ :=
  ((l.map (fun i => (coord i).1)).sum, (l.map (fun i => (coord i).2)).sum)

private def coordValid (i : Index) : Bool :=
  decide (coordSum [i, swap i] = (0,0) ∧ coordSum [i, rotate i, rotate (rotate i)] = (0,0) ∧
    coordSum (heckeTwo i ++ [i,i]) = (0,0) ∧ coordSum (i :: frickePath i) = (0,0))

private def chunkOK (test : Index → Bool) (b : ℕ) : Bool :=
  (List.finRange 15).all fun j => test (Fin.ofNat 390 (15*b+j.val))

private theorem checkedChunks (test : Index → Bool)
    (h : ∀ b : Fin 26, chunkOK test b = true) :
    (List.finRange 390).all test = true := by
  apply List.all_eq_true.mpr
  intro i _
  let b : Fin 26 := ⟨i.val / 15, by omega⟩
  let j : Fin 15 := ⟨i.val % 15, Nat.mod_lt _ (by decide)⟩
  have he : Fin.ofNat 390 (15*b.val+j.val) = i := by
    apply Fin.ext
    change (15*(i.val/15) + i.val%15)%390 = i.val
    rw [Nat.div_add_mod, Nat.mod_eq_of_lt i.isLt]
  have hv := List.all_eq_true.mp (h b) j (List.mem_finRange j)
  simpa only [he] using hv

