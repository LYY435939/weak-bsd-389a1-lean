private theorem coordinate_facts (i : Index) :
    coordSum [i, swap i] = (0,0) ∧
    coordSum [i, rotate i, rotate (rotate i)] = (0,0) ∧
    coordSum (heckeTwo i ++ [i,i]) = (0,0) ∧ coordSum (i :: frickePath i) = (0,0) := by
  simpa [coordValid] using List.all_eq_true.mp checkCoordinates i (List.mem_finRange i)

private theorem coordRelation (n : ℕ) : coordSum (relation n) = (0,0) := by
  unfold relation
  split
  · exact (coordinate_facts _).1
  · split
    · exact (coordinate_facts _).2.1
    · exact (coordinate_facts _).2.2.1

private theorem tally_get (xs : List (Index × ℤ)) (initial : Vector ℤ 390) (j : Index) :
    (tally xs initial)[j.val] = initial[j.val] + weightAt xs j := by
  induction xs generalizing initial with
  | nil => simp [tally, weightAt]
  | cons term xs ih =>
    obtain ⟨i,c⟩ := term
    simp only [tally, List.foldl_cons, weightAt, List.map_cons, List.sum_cons] at ih ⊢
    rw [ih, Vector.getElem_set]
    by_cases hij : i = j
    · subst i; simp [add_assoc]
    · have hd : i.val ≠ j.val := fun eq => hij (Fin.ext eq)
      simp [hij, hd]

private theorem filter_weightAt (i j : Index) (hne : j ≠ i) (hle : position i ≤ position j)
    (xs : List (Index × ℤ)) :
    weightAt (xs.filter (forbidden i)) j = weightAt xs j := by
  induction xs with
  | nil => rfl
  | cons t xs ih =>
    obtain ⟨m,c⟩ := t
    by_cases hm : m = j
    · subst m
      simp [forbidden, hne, hle, weightAt] at ih ⊢
      exact ih
    · by_cases hfor : forbidden i (m,c)
      · simp [hfor, weightAt, hm] at ih ⊢
        exact ih
      · simp [hfor, weightAt, hm] at ih ⊢
        exact ih

private theorem pivot_facts (i : Index) (h₁ : i ≠ 384) (h₂ : i ≠ 386) :
    (weights i)[i.val] ≠ 0 ∧
      ∀ j : Index, j = i ∨ position j < position i ∨ (weights i)[j.val] = 0 := by
  have hv := List.all_eq_true.mp checkPivots i (List.mem_finRange i)
  simp only [pivotValid, h₁, h₂, or_self, ↓reduceIte, Bool.and_eq_true,
    decide_eq_true_eq] at hv
  constructor
  · simpa [weights, tally_get] using hv.1
  · intro j
    by_cases hji : j = i
    · exact Or.inl hji
    by_cases hlt : position j < position i
    · exact Or.inr (Or.inl hlt)
    apply Or.inr ∘ Or.inr
    have he := congrArg (fun v : Vector ℤ 390 => v[j.val]) hv.2
    simpa only [weights, tally_get, Vector.getElem_replicate, zero_add,
      filter_weightAt i j hji (Nat.le_of_not_gt hlt)] using he

private theorem weight_dot {K : Type*} [Field K] (f : Index → K) (xs : List (Index × ℤ)) :
    ∑ j : Index, (weightAt xs j : K) * f j = (xs.map fun (i,c) => (c : K)*f i).sum := by
  classical
  induction xs with
  | nil => simp [weightAt]
  | cons t xs ih =>
    obtain ⟨i,c⟩ := t
    simp only [weightAt, List.map_cons, List.sum_cons, Int.cast_add, add_mul,
      Finset.sum_add_distrib] at ih ⊢
    rw [ih]
    congr 1
    simp [apply_ite, ite_mul]

private theorem combination_zero {K : Type*} [Field K] (f : Index → K)
    (h : ∀ n, ((relation n).map f).sum = 0) (cs : Combination) :
    ((expand cs).map fun (i,c) => (c : K)*f i).sum = 0 := by
  induction cs with
  | nil => rfl
  | cons t cs ih =>
    obtain ⟨n,c⟩ := t
    change ((((relation n).map (fun i => (i,c))) ++ expand cs).map
      fun (i,c) => (c : K)*f i).sum = 0
    rw [List.map_append, List.sum_append, ih, add_zero]
    simpa [List.map_map, Function.comp_def, List.sum_map_mul_left] using
      congrArg ((c : K) * ·) (h n)

private theorem uniqueness {K : Type*} [Field K] [CharZero K] (f : Index → K)
    (h : ∀ n, ((relation n).map f).sum = 0) (h₁ : f 384 = 0) (h₂ : f 386 = 0) :
    ∀ i, f i = 0 := by
  classical
  suffices hAll : ∀ n (i : Index), position i = n → f i = 0 from fun i => hAll _ i rfl
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro i hi
    by_cases hA : i = 384
    · simpa [hA] using h₁
    by_cases hB : i = 386
    · simpa [hB] using h₂
    obtain ⟨hw, hrest⟩ := pivot_facts i hA hB
    have hz : ∑ j : Index, (((weights i)[j.val] : ℤ) : K) * f j = 0 := by
      simp only [weights, tally_get, Vector.getElem_replicate, zero_add]
      rw [weight_dot, combination_zero f h]
    rw [Finset.sum_eq_single i] at hz
    · have hw' : (((weights i)[i.val] : ℤ) : K) ≠ 0 := by exact_mod_cast hw
      exact (mul_eq_zero.mp hz).resolve_left hw'
    · intro j _ hji
      rcases hrest j with heq | hlt | hzero
      · exact False.elim (hji heq)
      · rw [ih (position j) (hi ▸ hlt) j rfl, mul_zero]
      · rw [hzero, Int.cast_zero, zero_mul]
    · simp

private def difference {K : Type*} [Field K] (f : Index → K) (i : Index) :=
  2 * f i - (coord i).1 * f 384 - (coord i).2 * f 386

private theorem sum_difference {K : Type*} [Field K] (f : Index → K) (l : List Index) :
    (l.map (difference f)).sum =
      2 * (l.map f).sum - (coordSum l).1 * f 384 - (coordSum l).2 * f 386 := by
  induction l with
  | nil => simp [coordSum]
  | cons i l ih =>
    simp only [List.map_cons, List.sum_cons, ih, difference, coordSum, Int.cast_add]
    ring

private theorem relation_zero {K : Type*} [Field K] (f : Index → K)
    (hS : ∀ i, f i + f (swap i) = 0)
    (hR : ∀ i, f i + f (rotate i) + f (rotate (rotate i)) = 0)
    (hT : ∀ i, ((heckeTwo i).map f).sum = (-2 : K) * f i) (n : ℕ) :
    ((relation n).map f).sum = 0 := by
  unfold relation
  split
  · simpa using hS _
  · split
    · simpa [add_assoc] using hR _
    · simp [hT]; ring

/-- On every characteristic-zero field-valued Manin eigensymbol with T₂ eigenvalue −2,
the path action of W₃₈₉ is multiplication by −1. -/
theorem fricke_eq_neg {K : Type*} [Field K] [CharZero K] (f : Index → K)
    (hS : ∀ i, f i + f (swap i) = 0)
    (hR : ∀ i, f i + f (rotate i) + f (rotate (rotate i)) = 0)
    (hT : ∀ i, ((heckeTwo i).map f).sum = (-2 : K) * f i) (i : Index) :
    ((frickePath i).map f).sum = -f i := by
  have hd (n : ℕ) : ((relation n).map (difference f)).sum = 0 := by
    rw [sum_difference, coordRelation, relation_zero f hS hR hT]
    simp
  have cA : coord 384 = (2,0) := by decide +kernel
  have cB : coord 386 = (0,2) := by decide +kernel
  have hdz := uniqueness (difference f) hd (by simp [difference, cA]) (by simp [difference, cB])
  have hpath : ((i :: frickePath i).map (difference f)).sum = 0 := by
    simp [show difference f = fun _ => 0 from funext hdz]
  rw [sum_difference, (coordinate_facts i).2.2.2] at hpath
  simpa using (show ((frickePath i).map f).sum = -f i by
    simp only [List.map_cons, List.sum_cons, Int.cast_zero, zero_mul, sub_zero] at hpath
    exact eq_neg_of_add_eq_zero_right ((mul_eq_zero.mp hpath).resolve_left (by norm_num)))

