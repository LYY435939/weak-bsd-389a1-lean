import Mathlib

/-! The factorization of 2 and parity of the root-prime exponent for the cubic descent. -/
noncomputable section
namespace BSD.RankTwo389.TwoLocal

/-- The principal ideal factorization predicted by the Eisenstein relation.
    It holds in any commutative ring containing a root of the actual cubic;
    in particular it does not assume a power-integral basis. -/
theorem two_span_eq_root_cube {R : Type*} [CommRing R] (t : R)
    (ht : t^3 + 2*t^2 - 8*t + 2 = 0) :
    Ideal.span ({(2 : R)} : Set R) = (Ideal.span ({t} : Set R))^3 := by
  let u : R := t^2 - 4*t + 1
  let v : R := -111 + 34*t + 15*t^2
  have huv : u*v = 1 := by
    dsimp [u,v]
    linear_combination (15*t-56)*ht
  have ht3 : t^3 = 2 * (-u) := by
    dsimp [u]
    linear_combination ht
  have h2 : (2 : R) = t^3 * (-v) := by
    rw [ht3]
    linear_combination -2*huv
  rw [Ideal.span_singleton_pow]
  apply le_antisymm
  · apply Ideal.span_singleton_le_span_singleton.mpr
    exact ⟨-v, h2⟩
  · apply Ideal.span_singleton_le_span_singleton.mpr
    exact ⟨-u, ht3⟩

/-- Every prime ideal over 2 contains the root. This does not require
    that the order generated by the root equals the full ring of integers. -/
theorem prime_over_two_contains_root {R : Type*} [CommRing R] (t : R)
    (ht : t^3 + 2*t^2 - 8*t + 2 = 0) (P : Ideal R) (hP : P.IsPrime)
    (h2 : (2 : R) ∈ P) : t ∈ P := by
  apply hP.mem_of_pow_mem 3
  have hle : Ideal.span ({(2:R)} : Set R) ≤ P := Ideal.span_le.mpr (by simpa using h2)
  apply hle
  rw [two_span_eq_root_cube t ht, Ideal.span_singleton_pow]
  exact Ideal.subset_span (by simp)

/-- If the root ideal is maximal (e.g. its residue ring is F₂), it is
    the unique prime above 2. -/
theorem prime_over_two_unique_of_root_maximal {R : Type*} [CommRing R] (t : R)
    (ht : t^3 + 2*t^2 - 8*t + 2 = 0)
    (hm : (Ideal.span ({t} : Set R)).IsMaximal)
    (P : Ideal R) (hP : P.IsPrime) (h2 : (2 : R) ∈ P) :
    P = Ideal.span ({t} : Set R) := by
  apply Eq.symm
  apply hm.eq_of_le
  · exact hP.ne_top
  · apply Ideal.span_le.mpr
    simpa using prime_over_two_contains_root t ht P hP h2

/-- Norm two proves the root ideal maximal and identifies its residue
    cardinality, without any monogenicity assumption. -/
theorem root_ideal_maximal_of_absNorm_two {R : Type*} [CommRing R]
    [IsDedekindDomain R] [Module.Free ℤ R] (t : R)
    (hn : (Ideal.span ({t} : Set R)).absNorm = 2) :
    (Ideal.span ({t} : Set R)).IsMaximal ∧
      Nat.card (R ⧸ Ideal.span ({t} : Set R)) = 2 := by
  have hp : (Ideal.span ({t} : Set R)).IsPrime :=
    Ideal.isPrime_of_irreducible_absNorm (by rw [hn]; exact Nat.prime_two)
  have hne : Ideal.span ({t} : Set R) ≠ ⊥ := by
    intro he
    rw [he, Ideal.absNorm_bot] at hn
    omega
  refine ⟨hp.isMaximal hne, ?_⟩
  simpa [Ideal.absNorm_apply, Submodule.cardQuot_apply] using hn

/-- Every ideal not divisible by the unique root prime has odd norm. -/
theorem absNorm_odd_of_root_not_dvd {R : Type*} [CommRing R]
    [IsDedekindDomain R] [Module.Free ℤ R] [Module.Finite ℤ R] (t : R)
    (ht : t^3 + 2*t^2 - 8*t + 2 = 0)
    (hm : (Ideal.span ({t} : Set R)).IsMaximal)
    (J : Ideal R) (hJ : ¬ Ideal.span ({t} : Set R) ∣ J) :
    ¬ 2 ∣ J.absNorm := by
  intro hdiv
  obtain ⟨Q, hQ, hunder, hQJ⟩ :=
    Ideal.exists_isMaximal_dvd_of_dvd_absNorm' Nat.prime_two J hdiv
  have h2 : (2 : R) ∈ Q := by
    have hz : (2 : ℤ) ∈ Q.under ℤ := by
      rw [hunder]
      exact Ideal.subset_span (by simp)
    simpa using (Ideal.mem_under ℤ Q).mp hz
  have heq := prime_over_two_unique_of_root_maximal t ht hm Q hQ.isPrime h2
  exact hJ (heq ▸ hQJ)

/-- Valuation parity from a norm decomposition: if the only contribution
at 2 is 2^e and the remaining factor is odd, square norm forces e even. -/
theorem exponent_even_of_square_norm (e m k : ℕ) (hm : ¬2 ∣ m)
    (hm0 : m ≠ 0) (heq : 2^e*m = k^2) : Even e := by
  have hp : (2:ℕ)^e ≠ 0 := pow_ne_zero _ (by decide)
  have hfactor := congrArg (fun a : ℕ => a.factorization 2) heq
  rw [Nat.factorization_mul hp hm0, Nat.factorization_pow, Nat.factorization_pow] at hfactor
  simp only [Finsupp.add_apply, Finsupp.smul_apply, nsmul_eq_mul,
    Nat.Prime.factorization_self (by decide : Nat.Prime 2), mul_one,
    Nat.factorization_eq_zero_of_not_dvd hm, add_zero] at hfactor
  change e = 2 * k.factorization 2 at hfactor
  exact ⟨k.factorization 2, by omega⟩

/-- Ideal-level parity: after isolating the unique prime of norm 2, a
    square ideal norm makes its multiplicity even. The remaining ideal must
    be certified to have odd norm. -/
theorem ideal_exponent_even_of_square_absNorm {R : Type*} [CommRing R]
    [IsDedekindDomain R] [Module.Free ℤ R]
    (P J : Ideal R) (e : ℕ) (hP : P.absNorm = 2)
    (hJ : ¬ 2 ∣ J.absNorm) (hsq : IsSquare ((P^e * J).absNorm)) : Even e := by
  have h0 : J.absNorm ≠ 0 := by
    intro hz
    apply hJ
    rw [hz]
    exact dvd_zero 2
  obtain ⟨k, hk⟩ := hsq
  apply exponent_even_of_square_norm e J.absNorm k hJ h0
  have he : (P^e * J).absNorm = 2^e * J.absNorm := by
    rw [map_mul, map_pow, hP]
  rw [← he, hk]
  ring

/-- If the norm is square, the valuation at the unique prime above 2 is even. -/
theorem root_multiplicity_even_of_square_absNorm {R : Type*} [CommRing R]
    [IsDedekindDomain R] [Module.Free ℤ R] [Module.Finite ℤ R] (t : R)
    (ht : t^3 + 2*t^2 - 8*t + 2 = 0)
    (hn : (Ideal.span ({t} : Set R)).absNorm = 2)
    (I : Ideal R) (hI : I ≠ 0) (hsq : IsSquare I.absNorm) :
    Even (multiplicity (Ideal.span ({t} : Set R)) I) := by
  let P : Ideal R := Ideal.span ({t} : Set R)
  have hP : P.absNorm = 2 := hn
  have hm : P.IsMaximal := (root_ideal_maximal_of_absNorm_two t hn).1
  have hp : Prime P := UniqueFactorizationMonoid.irreducible_iff_prime.mp
    (Ideal.irreducible_of_irreducible_absNorm (by rw [hP]; exact Nat.prime_two))
  obtain ⟨J,hfac,hnot⟩ := (FiniteMultiplicity.of_prime_left hp hI).exists_eq_pow_mul_and_not_dvd
  have hj := absNorm_odd_of_root_not_dvd t ht hm J hnot
  rw [hfac] at hsq
  exact ideal_exponent_even_of_square_absNorm P J (multiplicity P I) hP hj hsq

/-- Concrete element form: square absolute rational norm forces even
    valuation at the unique root prime above two. -/
theorem root_multiplicity_even_of_element_norm_square
    {R : Type*} [CommRing R] [IsDedekindDomain R] [Module.Free ℤ R] [Module.Finite ℤ R]
    (t : R) (ht : t^3 + 2*t^2 - 8*t + 2 = 0)
    (hnt : Algebra.norm ℤ t = -2) (x : R) (hx : x ≠ 0)
    (hsq : IsSquare (Algebra.norm ℤ x).natAbs) :
    Even (multiplicity (Ideal.span ({t} : Set R)) (Ideal.span ({x} : Set R))) := by
  have hnorm : (Ideal.span ({t} : Set R)).absNorm = 2 := by
    rw [Ideal.absNorm_span_singleton, hnt]
    decide
  apply root_multiplicity_even_of_square_absNorm t ht hnorm (Ideal.span ({x} : Set R))
  · simpa using hx
  · rw [Ideal.absNorm_span_singleton]
    exact hsq

end BSD.RankTwo389.TwoLocal
