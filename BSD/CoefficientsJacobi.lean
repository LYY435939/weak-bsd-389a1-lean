import Mathlib.NumberTheory.JacobiSum.Basic
import Mathlib.Tactic.Ring
import Mathlib.Tactic.LinearCombination

open Finset

namespace BSD

variable {F : Type*} [Field F] [Fintype F] [DecidableEq F]

/-- Partition the affine Fermat cubic according to the cube of the first coordinate. -/
private def fermatAffineFiberEquiv :
    {p : F × F // p.1 ^ 3 + p.2 ^ 3 = 1} ≃
      Σ a : F, {x : F // x ^ 3 = a} × {y : F // y ^ 3 = 1 - a} where
  toFun p :=
    ⟨p.1.1 ^ 3, ⟨p.1.1, rfl⟩, ⟨p.1.2, eq_sub_of_add_eq (by simpa only [add_comm] using p.2)⟩⟩
  invFun p :=
    ⟨(p.2.1, p.2.2), by
      change p.2.1.1 ^ 3 + p.2.2.1 ^ 3 = 1
      rw [p.2.1.2, p.2.2.2, add_sub_cancel]⟩
  left_inv _ := rfl
  right_inv p := by
    rcases p with ⟨_, ⟨x, rfl⟩, y⟩
    rfl

/-- The affine count is the base field cardinality minus two plus the two cubic Jacobi sums. -/
theorem fermatAffine_card_eq_jacobiSum (χ : MulChar F ℂ)
    (hnontriv : χ ≠ 1) (hcube : χ ^ 3 = 1)
    (hfiber : ∀ a : F, (Fintype.card {x : F // x ^ 3 = a} : ℂ) = 1 + χ a + χ⁻¹ a) :
    (Fintype.card {p : F × F // p.1 ^ 3 + p.2 ^ 3 = 1} : ℂ) =
      (Fintype.card F : ℂ) - 2 + jacobiSum χ χ + jacobiSum χ⁻¹ χ⁻¹ := by
  have hsum : ∑ a : F, χ a = 0 := MulChar.sum_eq_zero_of_ne_one hnontriv
  have hisum : ∑ a : F, χ⁻¹ a = 0 := MulChar.sum_eq_zero_of_ne_one (inv_ne_one.mpr hnontriv)
  have hsumSub : ∑ a : F, χ (1 - a) = 0 := (Equiv.subLeft (1 : F)).sum_comp χ |>.trans hsum
  have hisumSub : ∑ a : F, χ⁻¹ (1 - a) = 0 :=
    (Equiv.subLeft (1 : F)).sum_comp (fun a ↦ χ⁻¹ a) |>.trans hisum
  have hcross : jacobiSum χ χ⁻¹ = -1 := by
    rw [jacobiSum_nontrivial_inv hnontriv,
      MulChar.val_neg_one_eq_one_of_odd_order (by decide : Odd 3) hcube]
  have hcross' : jacobiSum χ⁻¹ χ = -1 := (jacobiSum_comm _ _).trans hcross
  calc
    _ = ∑ a : F, (1 + χ a + χ⁻¹ a) * (1 + χ (1 - a) + χ⁻¹ (1 - a)) := by
      rw [Fintype.card_congr (fermatAffineFiberEquiv (F := F)), Fintype.card_sigma, Nat.cast_sum]
      simp only [Fintype.card_prod, Nat.cast_mul, hfiber]
    _ = ∑ a : F, (1 + χ a + χ⁻¹ a + χ (1 - a) + χ⁻¹ (1 - a) +
        χ a * χ (1 - a) + χ a * χ⁻¹ (1 - a) +
        χ⁻¹ a * χ (1 - a) + χ⁻¹ a * χ⁻¹ (1 - a)) := by
      apply Finset.sum_congr rfl
      intro a _
      ring
    _ = (Fintype.card F : ℂ) + jacobiSum χ χ + jacobiSum χ χ⁻¹ +
        jacobiSum χ⁻¹ χ + jacobiSum χ⁻¹ χ⁻¹ := by
      simp only [Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one,
        hsum, hisum, hsumSub, hisumSub, add_zero, jacobiSum]
    _ = _ := by rw [hcross, hcross']; ring

omit [DecidableEq F] in
/-- A finite field with cardinality one modulo three has a nontrivial cubic character. -/
theorem exists_cubic_mulChar (h : 3 ∣ Fintype.card F - 1) :
    ∃ χ : MulChar F ℂ, χ ≠ 1 ∧ χ ^ 3 = 1 := by
  obtain ⟨χ, hχ⟩ := MulChar.exists_mulChar_orderOf F h
    (Complex.isPrimitiveRoot_exp 3 (by decide))
  refine ⟨χ, ?_, hχ ▸ pow_orderOf_eq_one χ⟩
  rintro rfl
  simp at hχ

omit [DecidableEq F] in
/-- The Jacobi sum of the inverse character is the complex conjugate. -/
theorem cubic_jacobiSum_conj (χ : MulChar F ℂ) :
    jacobiSum χ⁻¹ χ⁻¹ = star (jacobiSum χ χ) := by
  have h := jacobiSum_ringHomComp χ χ (starRingEnd ℂ)
  change jacobiSum (star χ) (star χ) = star (jacobiSum χ χ) at h
  simpa only [MulChar.star_eq_inv] using h

omit [DecidableEq F] in
/-- The Jacobi sum of a nontrivial cubic character has squared complex norm equal to the field
cardinality. -/
theorem cubic_jacobiSum_mul_inv (χ : MulChar F ℂ) (hnontriv : χ ≠ 1)
    (hcube : χ ^ 3 = 1) : jacobiSum χ χ * jacobiSum χ⁻¹ χ⁻¹ = Fintype.card F := by
  refine jacobiSum_mul_jacobiSum_inv ?_ hnontriv hnontriv ?_
  · rw [ringChar.eq ℂ 0]
    exact (CharP.ringChar_ne_zero_of_finite F).symm
  · intro h
    apply hnontriv
    rwa [pow_succ, pow_two, h, one_mul] at hcube

private theorem primitiveCubeRoot_relation {μ : ℂ} (hμ : IsPrimitiveRoot μ 3) :
    μ ^ 2 + μ + 1 = 0 := by
  have h := hμ.geom_sum_eq_zero (by decide : 1 < 3)
  simp only [sum_range_succ, range_zero, sum_empty, pow_zero, pow_one, zero_add] at h
  linear_combination h

/-- The integer algebra generated by a primitive cube root has basis (1,mu). -/
private theorem exists_pair_of_mem_cubic_adjoin {μ z : ℂ} (hμ : IsPrimitiveRoot μ 3)
    (hz : z ∈ Algebra.adjoin ℤ ({μ} : Set ℂ)) :
    ∃ a b : ℤ, z = (a : ℂ) + (b : ℂ) * μ := by
  have hμ₂ : μ ^ 2 + μ + 1 = 0 := primitiveCubeRoot_relation hμ
  induction hz using Algebra.adjoin_induction with
  | mem x hx =>
    obtain rfl : x = μ := Set.mem_singleton_iff.mp hx
    exact ⟨0, 1, by simp⟩
  | algebraMap a => exact ⟨a, 0, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨a, b, rfl⟩ := hx
    obtain ⟨c, d, rfl⟩ := hy
    exact ⟨a + c, b + d, by push_cast; ring⟩
  | mul x y _ _ hx hy =>
    obtain ⟨a, b, rfl⟩ := hx
    obtain ⟨c, d, rfl⟩ := hy
    refine ⟨a * c - b * d, a * d + b * c - b * d, ?_⟩
    push_cast
    linear_combination (b : ℂ) * (d : ℂ) * hμ₂

omit [DecidableEq F] in
/-- The negative Jacobi sum has integer coordinates congruent to (1,0) modulo three. -/
theorem exists_cubic_jacobiSum_primary_coordinates {μ : ℂ} (hμ : IsPrimitiveRoot μ 3)
    (h : 3 ∣ Fintype.card F - 1) (χ : MulChar F ℂ) (hcube : χ ^ 3 = 1) :
    ∃ a b : ℤ, 3 ∣ a - 1 ∧ 3 ∣ b ∧ -jacobiSum χ χ = (a : ℂ) + (b : ℂ) * μ := by
  obtain ⟨z, hz, hJ⟩ :=
    exists_jacobiSum_eq_neg_one_add (by decide : 2 < 3) hcube hcube h hμ
  have hμz : μ * z ∈ Algebra.adjoin ℤ ({μ} : Set ℂ) :=
    Subalgebra.mul_mem _ (Algebra.self_mem_adjoin_singleton ℤ μ) hz
  obtain ⟨a, b, hpair⟩ := exists_pair_of_mem_cubic_adjoin hμ hμz
  have hμ₂ : μ ^ 2 + μ + 1 = 0 := primitiveCubeRoot_relation hμ
  refine ⟨1 + 3 * a, 3 * b, ⟨a, by ring⟩, dvd_mul_right 3 b, ?_⟩
  rw [hJ]
  push_cast
  linear_combination -z * hμ₂ + 3 * hpair

omit [DecidableEq F] in
/-- Integer norm and trace of the negated cubic Jacobi sum. -/
theorem cubic_jacobiSum_norm_trace {μ : ℂ} (hμ : IsPrimitiveRoot μ 3)
    (χ : MulChar F ℂ) (hnontriv : χ ≠ 1) (hcube : χ ^ 3 = 1)
    {a b : ℤ} (hJ : -jacobiSum χ χ = (a : ℂ) + (b : ℂ) * μ) :
    a ^ 2 - a * b + b ^ 2 = (Fintype.card F : ℤ) ∧
      -jacobiSum χ χ - jacobiSum χ⁻¹ χ⁻¹ = ((2 * a - b : ℤ) : ℂ) := by
  have hμ₂ : μ ^ 2 + μ + 1 = 0 := primitiveCubeRoot_relation hμ
  have hμ₃ : μ ^ 3 = 1 := hμ.pow_eq_one
  have hμc : star μ = μ ^ 2 := by
    rw [Complex.star_def, ← Complex.inv_eq_conj (Complex.norm_eq_one_of_pow_eq_one hμ₃ (by decide))]
    apply inv_eq_of_mul_eq_one_right
    linear_combination hμ₃
  have hJ' : -jacobiSum χ⁻¹ χ⁻¹ = (a : ℂ) + (b : ℂ) * μ ^ 2 := by
    rw [cubic_jacobiSum_conj]
    simpa only [star_neg, star_add, star_mul, star_intCast, hμc, mul_comm (μ ^ 2)]
      using congrArg (star : ℂ → ℂ) hJ
  constructor
  · have hprod : ((a : ℂ) + (b : ℂ) * μ) * ((a : ℂ) + (b : ℂ) * μ ^ 2) = Fintype.card F := by
      rw [← hJ, ← hJ', neg_mul_neg, cubic_jacobiSum_mul_inv χ hnontriv hcube]
    have hnorm : (a : ℂ) ^ 2 - (a : ℂ) * (b : ℂ) + (b : ℂ) ^ 2 = Fintype.card F := by
      linear_combination hprod - (a : ℂ) * (b : ℂ) * hμ₂ - (b : ℂ) ^ 2 * hμ₃
    exact_mod_cast hnorm
  · rw [sub_eq_add_neg, hJ, hJ']
    push_cast
    linear_combination (b : ℂ) * hμ₂

end BSD
